<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(MobileTargetFramework)' != ''">$(MobileTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SamElla.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Sam n' Ella</ApplicationTitle>
    <ApplicationId>com.suesslabs.samella</ApplicationId>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <Import Project="../GameVersion.props" />
  <ItemGroup>
    <ProjectReference Include="../SamElla.Core/SamElla.Core.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="../Docs/Sam-and-Ella.png"
      ForegroundScale="0.65" Color="#17263F" Resize="true" BaseSize="128,128" />
    <MauiSplashScreen Include="../Docs/Sam-and-Ella.png" Link="Resources/Splash/sam_ella.png"
      Color="#17263F" Resize="true" BaseSize="128,128" />
    <MauiAsset Include="../SamElla/Assets/**/*.sprite;../SamElla/Assets/**/*.txt"
      Exclude="../SamElla/Assets/AppIcon/**;../SamElla/Assets/Previews/**"
      LogicalName="Game/Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="../SamElla/Levels/*.txt" LogicalName="Game/Levels/%(Filename)%(Extension)" />
    <MauiAsset Include="../SamElla/ThirdPartyNotices.txt" LogicalName="ThirdPartyNotices.txt" />
    <MauiAsset Include="Resources/Notices/*" LogicalName="Notices/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CreateGameContentManifest" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <GameArt Include="../SamElla/Assets/**/*.sprite;../SamElla/Assets/**/*.txt" Exclude="../SamElla/Assets/AppIcon/**;../SamElla/Assets/Previews/**" />
      <GameLevel Include="../SamElla/Levels/*.txt" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)game-content.txt" Lines="@(GameArt->'Assets/%(RecursiveDir)%(Filename)%(Extension)');@(GameLevel->'Levels/%(Filename)%(Extension)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><MauiAsset Include="$(IntermediateOutputPath)game-content.txt" LogicalName="game-content.txt" /></ItemGroup>
  </Target>
</Project>
