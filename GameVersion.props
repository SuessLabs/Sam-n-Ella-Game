<Project>
  <PropertyGroup>
    <FileVersion>0.8.0.125</FileVersion>
    <AssemblyVersion>0.8.0.125</AssemblyVersion>
    <Version>$(FileVersion)</Version>
    <!-- iOS shortens Version to three parts; NuGet requires one package version across all targets. -->
    <PackageVersion>$(FileVersion)</PackageVersion>
    <!-- Store build numbers must keep increasing even when the release prefix changes. -->
    <MobileBuildNumber>125</MobileBuildNumber>
    <ApplicationDisplayVersion Condition="'$(TargetFramework)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(FileVersion)</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">$([System.Version]::Parse('$(FileVersion)').ToString(3))</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">$(MobileBuildNumber)</ApplicationVersion>
  </PropertyGroup>
</Project>
